# Local development with mkcert HTTPS (Vite on 5179)
# Copy to .env.local:
# VITE_SITE_URL=https://dev.exaltavit.com:5179
# VITE_DEV_HTTPS=true
#
# If you run Caddy (see Caddyfile) so the site is on :443 without a port:
# VITE_SITE_URL=https://dev.exaltavit.com
# VITE_DEV_HTTPS=true

VITE_SITE_URL=https://dev.exaltavit.com:5179
VITE_DEV_HTTPS=true

# Staging / Netlify (production branch: main)
# Set in Netlify site env (do not set VITE_DEV_HTTPS there):
# VITE_SITE_URL=https://exaltavit.netlify.app

# Netlify Functions (form email + /admin). Set in Netlify site env; for `netlify dev`, put them in .env.
# ADMIN_PASSWORD        — password for the footer Admin login at /admin
# SESSION_SECRET        — long random string used to sign the admin session cookie
# SETTINGS_ENCRYPTION_KEY — 32 random bytes, base64 (encrypts the SMTP password in Netlify Blobs)
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Node:       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ADMIN_PASSWORD=
# SESSION_SECRET=
# SETTINGS_ENCRYPTION_KEY=
